# Copy this to .env and fill in your values
# .env is gitignored and will not be committed

# UMLBot backend URL (default: http://localhost:8000)
UMLBOT_ENDPOINT=http://localhost:8000

# LLM configuration
OPENAI_COMPATIBLE_ENDPOINT=https://your-proxy-endpoint/v1
OPENAI_COMPATIBLE_MODEL=o3
OPENAI_COMPATIBLE_KEY=your-api-key-here

# PlantUML JAR path (defaults to /opt/plantuml/plantuml.jar in Docker)
# UMLBOT_PLANTUML_JAR_PATH=/opt/plantuml/plantuml.jar
